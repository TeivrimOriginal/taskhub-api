# ======================================================================================
# TaskHub API — example environment file.  Copy to `.env` and adjust.
#   cp .env.example .env
# Every variable below is read by `app.core.config.Settings` (pydantic-settings).
# ======================================================================================

# ------------------------------------------------------------------ application
APP_NAME=TaskHub API
ENVIRONMENT=local                  # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true -> machine readable (structlog) logs

# ------------------------------------------------------------------ security
SECRET_KEY=change-me-to-a-50-char-random-string-minimum
JWT_ALGORITHM=HS256
JWT_AUDIENCE=taskhub-api
JWT_ISSUER=taskhub-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------ postgresql
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=taskhub
POSTGRES_SYNC_URI=postgresql://taskhub:taskhub@postgres:5432/taskhub
POSTGRES_ASYNC_URI=postgresql+asyncpg://taskhub:taskhub@postgres:5432/taskhub

# override for local development without docker:
# POSTGRES_ASYNC_URI=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/taskhub

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# ------------------------------------------------------------------ cors / hosts
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------ rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------ cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------ celery
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------ smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM=taskhub@localhost
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------ observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ------------------------------------------------------------------ bootstrap admin
FIRST_SUPERUSER_EMAIL=admin@taskhub.dev
FIRST_SUPERUSER_PASSWORD=Admin123!
FIRST_SUPERUSER_NAME=TaskHub Admin